; Engine configuration file.
; It's best edited using the editor UI and not directly.
;
; Tumble — G16 node 1: Linux-native first-person 3D scaffold.
; Renderer: GL Compatibility (broad GPU + software-LLVMpipe support).
; Physics:  Jolt Physics (built into Godot 4.4+, ideal for hundreds of
;           concurrently simulated rigid bodies — the destruction core).

config_version=5

[application]

config/name="Tumble"
config/description="First-person 3D destruction game — G16 node 5 (destruction sound: deep rumbly crash/explosion scaled to debris, crisp pew-pew fire, wired to shatter/fire events)."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.53, 0.81, 0.92, 1)

[autoload]

AudioManager="*res://scripts/audio/audio_manager.gd"
